! Independent fixed-geometry FeSe calculation; run B_a100_FM_r04
! a,c in Angstrom; fractional sites; four Fe per cell.
! Feu/Fed share one exact UPF; starting polarization is NOT constrained moment.
&CONTROL
 calculation='scf', restart_mode='from_scratch', prefix='fese',
 pseudo_dir='../../pseudos', outdir='./scratch', verbosity='high',
 tprnfor=.true., tstress=.true., disk_io='low', max_seconds=1800,
/
&SYSTEM
 ibrav=0, nat=8, ntyp=2, nspin=2,
 ecutwfc=90, ecutrho=360, nbnd=84,
 occupations='smearing', smearing='mv', degauss=0.02,
 starting_magnetization(1)=0.15,
/
&ELECTRONS
 conv_thr=1e-07, electron_maxstep=120,
 mixing_beta=0.3, mixing_mode='plain', diagonalization='david',
 startingpot='atomic', startingwfc='atomic+random',
/
ATOMIC_SPECIES
Feu 55.845 Fe_std.upf
Se 78.971 Se_std.upf
CELL_PARAMETERS angstrom
3.765000000000 3.765000000000 0.000000000000
-3.765000000000 3.765000000000 0.000000000000
0.000000000000 0.000000000000 5.518000000000
ATOMIC_POSITIONS crystal
Feu 0.000000000000 0.000000000000 0.000000000000
Feu 0.500000000000 0.000000000000 0.000000000000
Feu 0.000000000000 0.500000000000 0.000000000000
Feu 0.500000000000 0.500000000000 0.000000000000
Se 0.250000000000 0.750000000000 0.234300000000
Se 0.750000000000 0.250000000000 0.234300000000
Se 0.250000000000 0.250000000000 0.765700000000
Se 0.750000000000 0.750000000000 0.765700000000
K_POINTS automatic
2 2 2 0 0 0
